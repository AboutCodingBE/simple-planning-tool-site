# .dockerignore
# Excludes files from Docker build context (makes builds faster and images smaller)

# Dependencies (will be installed fresh in container)
node_modules
npm-debug.log

# Build output (will be generated in container)
dist
.angular

# IDE files
.idea
.vscode
*.swp
*.swo
*~

# Git
.git
.gitignore

# Testing
coverage
*.spec.ts

# Environment files (don't include in image)
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Documentation
README.md
docs/

# CI/CD
.github
.gitlab-ci.yml

# Docker files (don't need these inside the image)
Dockerfile
docker-compose.yml
.dockerignore
